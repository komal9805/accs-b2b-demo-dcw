{
  "version": 1,
  "code": {
    "owner": "{ORG}",
    "repo": "{REPO}",
    "source": {
      "type": "github",
      "url": "https://github.com/{ORG}/{REPO}"
    }
  },
  "content": {
    "source": {
      "url": "{CONTENT_SOURCE}",
      "type": "onedrive"
    }
  },
  "folders": {
    "/products/": "/products/default",
    "/fr/products/": "/fr/products/default"
  },
  "cdn": {
    "live": {
      "host": "main--{SITE}--{ORG}.aem.live"
    },
    "preview": {
      "host": "main--{SITE}--{ORG}.aem.page"
    }
  },
  "headers": {},
  "public": {
    "default": {
      "commerce-core-endpoint": "https://na1-sandbox.api.commerce.adobe.com/XjwLSnzMD376938ESNdoJm/graphql",
      "commerce-endpoint": "https://na1-sandbox.api.commerce.adobe.com/XjwLSnzMD376938ESNdoJm/graphql",
      "headers": {
        "all": {
          "Store": "default"
        },
        "cs": {
          "Magento-Store-Code": "main_website_store",
          "Magento-Store-View-Code": "default",
          "Magento-Website-Code": "base",
          "x-api-key": "{COMMERCE_API_KEY}",
          "Magento-Environment-Id": "{COMMERCE_ENVIRONMENT_ID}"
        }
      },
      "analytics": {
        "base-currency-code": "USD",
        "environment": "Production",
        "store-id": "1",
        "store-name": "Main Website Store",
        "store-url": "https://coresaas-subgraph-external:8000/XjwLSnzMD376938ESNdoJm/",
        "store-view-id": "1",
        "store-view-name": "English Store View",
        "website-id": "1",
        "website-name": "Main Website"
      },
      "plugins": {
        "picker": {
           "rootCategory": "2"
         }
      }
    },
    "/fr/": {
      "headers": {
        "all": {
          "Store": "fr_eu"
        },
        "cs": {
          "Magento-Store-Code": "main_website_store",
          "Magento-Website-Code": "base",
          "Magento-Store-View-Code": "fr_eu"
        }
      },
      "analytics": {
        "store-view-code": "fr_eu",
        "store-view-id": "5",
        "store-view-name": "French Store View"
      }
    }
  },
  "robots": {
    "txt": "User-agent: *\nAllow: /\nDisallow: /drafts/\nDisallow: /enrichment/\nDisallow: /tools/\nDisallow: /plugins/experimentation/\n\nSitemap: https://{DOMAIN}/sitemap-index.xml"
  },
  "access": {
    "admin": {
      "role": {
        "config_admin": [
          "{ADMIN_USER_EMAIL}"
        ]
      },
      "requireAuth": "auto"
    }
  }
}
